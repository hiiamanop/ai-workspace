# Setup: cp .env.example .env — required before `docker compose up` (env_file: .env is not optional)
# Docker (docker compose up) — active values below, this is the primary supported path
MADE_URL=http://made:8000
SEARXNG_URL=http://searxng:8080
SCRAPLING_URL=http://scrapling:8000/mcp
# Shared bearer token for Scrapling's Streamable HTTP MCP endpoint.
# Generate with: openssl rand -hex 32
SCRAPLING_MCP_AUTH_TOKEN=

# Bare `npm run dev` (no docker) — uncomment these instead of the Docker values above
# MADE_URL=http://localhost:8001
# SEARXNG_URL=http://localhost:8080
# SCRAPLING_URL=http://localhost:8000/mcp
# OPENWEBUI_URL=http://localhost:3001

# OmniRouter is the primary OpenAI-compatible gateway.
# The supported Docker path reaches the WSL gateway through host.docker.internal.
# For bare `npm run dev`, override this with http://localhost:20128/v1.
OMNIROUTER_API_KEY=
OMNIROUTER_BASE_URL=http://host.docker.internal:20128/v1
# Optional comma-separated curated route IDs. Empty means all static routes.
OMNIROUTER_MODEL_ALLOWLIST=
# The reviewed fallback catalog is static in src/candidates.ts; do not turn
# arbitrary /v1/models results or environment values into an allowlist.
# Current fallback: openrouter/minimax/minimax-m3:free.

# Optional legacy provider for policy tooling compatibility.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Open WebUI's own session-signing secret (JWT) — NOT an LLM API key, has
# nothing to do with any model provider. It signs login-session tokens for
# Open WebUI's own auth system; if it changes, everyone gets logged out.
# REQUIRED — the open-webui container refuses to start if this is blank.
# Generate one with: echo "WEBUI_SECRET_KEY=$(openssl rand -hex 32)" >> .env
WEBUI_SECRET_KEY=

# Policy authoring backend (C1): the policies router in Open WebUI reaches
# the compiler (this repo's Node app) and MADE. Both default to the compose
# network (http://app:3000 / http://made:8000) and need no .env entry —
# override only for non-compose runs.
# POLICY_COMPILER_URL=http://app:3000
# MADE_URL=http://made:8000

# MADE-routing Filter provisioning and health monitor
# These are NOT LLM API keys — they're credentials for Open WebUI's own admin account.
# Create a dedicated account via Open WebUI's sign-up, mark it admin.
# REQUIRED for provisioning. If set, the health monitor also runs automatically.
OPENWEBUI_URL=http://open-webui:8080
OPENWEBUI_ADMIN_EMAIL=
OPENWEBUI_ADMIN_PASSWORD=

# Legacy direct-upstream Auto Pipe is optional. Leave disabled to use the
# native OpenWebUI model connection, MADE routing Filter, and native Tools.
# ENABLE_AUTO_PIPE=false

# Backend base URL used by the provisioned web_search/scrape Open WebUI Tools (D1).
# From inside the open-webui container the compose `app` service is http://app:3000;
# host-dev setups should set http://localhost:3000 instead.
# OPENWEBUI_BACKEND_URL=http://app:3000

# MADE's confidentiality pipeline: symmetric key encrypting the entity-mapping
# table at rest (original PII values behind each [PLACEHOLDER]). NOT an LLM
# API key. REQUIRED for POST /privacy/redact and /privacy/restore to work —
# MADE refuses those calls without it (other endpoints are unaffected).
# Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MADE_MAPPING_ENCRYPTION_KEY=
# Optional provider-backed ambiguity resolver. The provider receives the raw
# text; enable only when that transfer is approved by your data policy.
REDACTION_LLM_ENABLED=false
REDACTION_LLM_MODEL=auto
REDACTION_LLM_TIMEOUT_SECONDS=20
