# Setup: cp .env.example .env — required before `docker compose up` (env_file: .env is not optional)
# Docker (docker compose up) — active values below, this is the primary supported path
MADE_URL=http://made:8000
SEARXNG_URL=http://searxng:8080
SCRAPLING_URL=http://scrapling:8000/mcp
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Must match the OLLAMA_CONTEXT_LENGTH the Ollama server is actually started with
OLLAMA_CONTEXT_WINDOW=8192

# Bare `npm run dev` (no docker) — comment out the block above and uncomment this instead
# MADE_URL=http://localhost:8001
# SEARXNG_URL=http://localhost:8080
# SCRAPLING_URL=http://localhost:8000/mcp
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CONTEXT_WINDOW=8192
# OPENWEBUI_URL=http://localhost:3001

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Open WebUI's own session-signing secret (JWT) — NOT an LLM API key, has
# nothing to do with any model provider. It signs login-session tokens for
# Open WebUI's own auth system; if it changes, everyone gets logged out.
# REQUIRED — the open-webui container refuses to start if this is blank.
# Generate one with: echo "WEBUI_SECRET_KEY=$(openssl rand -hex 32)" >> .env
WEBUI_SECRET_KEY=

# MADE-routing Filter provisioning and health monitor
# These are NOT LLM API keys — they're credentials for Open WebUI's own admin account.
# Create a dedicated account via Open WebUI's sign-up, mark it admin.
# REQUIRED for provisioning and health monitor.
OPENWEBUI_URL=http://open-webui:8080
OPENWEBUI_ADMIN_EMAIL=
OPENWEBUI_ADMIN_PASSWORD=

# Classifier model (complexity classifier for MADE's task characterization)
# Used during provisioning to configure the Filter's valves.
# Must be available in Open WebUI (e.g., hosted locally or via a provider).
CLASSIFIER_MODEL=deepseek-v4-flash

# Health monitor (optional; omit or comment out to disable)
# The monitor checks MADE's health periodically and toggles tier visibility:
# - MADE healthy: brand selectable, tiers hidden (routed through MADE)
# - MADE unhealthy: tiers directly selectable by users
# Signs in fresh on each check (uses OPENWEBUI_ADMIN_EMAIL/PASSWORD above).
HEALTH_MONITOR_ENABLED=true
